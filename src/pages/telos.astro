---
import Layout from '../layouts/Layout.astro';
import { daemonData } from '../generated/daemon-data';

// Split telos items into problems, missions, and goals
const problems = daemonData.telos.filter(item => item.startsWith('P'));
const missions = daemonData.telos.filter(item => item.startsWith('M'));
const goals = daemonData.telos.filter(item => item.startsWith('G'));
---

<Layout title="TELOS | Problems Missions Goals and Life Direction" description="Personal framework for tracking purpose and direction in life">
  <main class="relative z-10 pt-28 pb-20 px-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-12">
        <h1 class="font-display text-4xl sm:text-5xl text-gradient mb-4">TELOS Framework</h1>
        <p class="font-body text-lg text-text-secondary">
          Problems I'm working to solve and missions I'm pursuing.
        </p>
      </div>

      <!-- Problems -->
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-sm font-bold text-accent bg-accent/20 px-3 py-1 rounded">P</span>
          <h2 class="font-heading text-2xl text-text-primary">Problems</h2>
        </div>
        <p class="font-body text-text-secondary mb-6">
          What I'm working to solve.
        </p>

        <div class="space-y-4">
          {problems.map((item) => {
            const match = item.match(/^(P\d+):\s*(.+?)\s*—\s*(.+)$/);
            if (!match) return null;
            const [, id, title, description] = match;
            return (
              <div class="bg-bg-secondary border border-border-default p-5">
                <div class="flex items-start gap-4">
                  <span class="font-mono text-sm font-bold text-accent shrink-0">{id}</span>
                  <div>
                    <h3 class="font-heading text-base text-text-primary mb-1">{title}</h3>
                    <p class="font-body text-sm text-text-secondary">{description}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Missions -->
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-sm font-bold text-brand bg-brand/20 px-3 py-1 rounded">M</span>
          <h2 class="font-heading text-2xl text-text-primary">Missions</h2>
        </div>
        <p class="font-body text-text-secondary mb-6">
          What I'm doing about it.
        </p>

        <div class="space-y-4">
          {missions.map((item) => {
            const match = item.match(/^(M\d+):\s*(.+?)\s*—\s*(.+)$/);
            if (!match) return null;
            const [, id, title, description] = match;
            return (
              <div class="bg-bg-secondary border border-border-default p-5">
                <div class="flex items-start gap-4">
                  <span class="font-mono text-sm font-bold text-brand shrink-0">{id}</span>
                  <div>
                    <h3 class="font-heading text-base text-text-primary mb-1">{title}</h3>
                    <p class="font-body text-sm text-text-secondary">{description}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Goals -->
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-sm font-bold text-green-400 bg-green-400/20 px-3 py-1 rounded">G</span>
          <h2 class="font-heading text-2xl text-text-primary">Goals</h2>
        </div>
        <p class="font-body text-text-secondary mb-6">
          Where I'm headed.
        </p>

        <div class="space-y-4">
          {goals.map((item) => {
            const match = item.match(/^(G\d+):\s*(.+?)\s*—\s*(.+)$/);
            if (!match) return null;
            const [, id, title, description] = match;
            return (
              <div class="bg-bg-secondary border border-border-default p-5">
                <div class="flex items-start gap-4">
                  <span class="font-mono text-sm font-bold text-green-400 shrink-0">{id}</span>
                  <div>
                    <h3 class="font-heading text-base text-text-primary mb-1">{title}</h3>
                    <p class="font-body text-sm text-text-secondary">{description}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Footer -->
      <section class="border-t border-border-subtle pt-8">
        <p class="font-body text-sm text-text-tertiary italic">
          "The pursuit itself is the purpose."
        </p>
      </section>
    </div>
  </main>
</Layout>
